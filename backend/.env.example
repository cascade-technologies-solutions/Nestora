# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nestora_db?schema=public"

# Authentication & Security Secrets (Replace with secure keys in production)
JWT_SECRET=super_secret_nestora_jwt_access_key_min_32_characters_long!
JWT_REFRESH_SECRET=super_secret_nestora_jwt_refresh_key_min_32_characters_long!

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://cascade-technologies-solutions.github.io

# Super Admin Initial Seeding Credentials
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=NestoraSuperAdmin2026!

# Storage Configuration (Dual-Mode: Local Disk fallback or S3/Cloudflare R2)
# Set to 's3' or provide valid AWS/R2 credentials to activate cloud storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=nestora-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=http://localhost:4000/uploads
